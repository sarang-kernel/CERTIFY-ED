import CertifyCore
import CertifyMathlib
import CertifyApps

/-!
# Axiom audit of the three libraries

Run with `lake env lean Audit/AxiomAudit.lean` after `lake build CertifyCore CertifyMathlib CertifyApps`. For every
theorem whose module belongs to `CertifyCore`, `CertifyMathlib` or `CertifyApps`, the command below collects the
axioms that the theorem depends on (through `Lean.collectAxioms`, which reads the axiom lists that Lean stores in each
compiled module) and prints, per library, the number of theorems, the union of their axioms, and every theorem that
depends on an axiom other than `propext`, `Classical.choice` and `Quot.sound`. A `sorry` shows up as `sorryAx` and a
`native_decide` as `Lean.ofReduceBool`, so both would be listed. Auxiliary theorems generated by Lean (names with an
internal component, such as equation lemmas) are counted separately.
-/

open Lean Elab Command

private def auditRoots : List Name := [`CertifyCore, `CertifyMathlib, `CertifyApps]

elab "#axiom_audit" : command => do
  let env ← getEnv
  let standard : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let thms : Array Name := env.constants.fold (init := #[]) fun acc n ci =>
    match ci with
    | .thmInfo _ => acc.push n
    | _ => acc
  for root in auditRoots do
    let mut named : Nat := 0
    let mut internal : Nat := 0
    let mut union : NameSet := {}
    let mut bad : Array (Name × Array Name) := #[]
    for n in thms do
      let some idx := env.getModuleIdxFor? n | continue
      let modName := env.header.moduleNames[idx.toNat]!
      unless modName.getRoot == root do continue
      if n.isInternal then internal := internal + 1 else named := named + 1
      let axs ← collectAxioms n
      for a in axs do union := union.insert a
      let extra := axs.filter fun a => !standard.contains a
      unless extra.isEmpty do bad := bad.push (n, extra)
    let unionList := (union.toList.map toString).toArray.qsort (· < ·)
    logInfo m!"AUDIT {root}: theorems={named} auxiliary={internal} axioms={unionList} nonstandard={bad.size}"
    for (n, extra) in bad do
      logInfo m!"AUDIT {root}: NONSTANDARD {n} {extra}"

#axiom_audit
