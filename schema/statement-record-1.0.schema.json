{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:certify-ed:schema:statement-record:1.0",
  "title": "CERTIFY-ED standalone statement record, schema 1.0",
  "description": "JSON record written by certify_ed.variational (E-05), certify_ed.generalized (E-03), certify_ed.moments (C-07) and certify_ed.nonhermitian (E-02). A statement with status CERTIFIED_UNDER_HYPOTHESIS names at least one hypothesis; DECLARED marks a producer value that is recorded, not certified.",
  "type": "object",
  "required": [
    "schema",
    "statements",
    "record_sha256"
  ],
  "properties": {
    "schema": {
      "enum": [
        "certify-ed/variational/1.0",
        "certify-ed/generalized/1.0",
        "certify-ed/moments/1.0",
        "certify-ed/nonhermitian/1.0"
      ]
    },
    "description": {
      "type": "string"
    },
    "operator": {
      "type": "object"
    },
    "state": {
      "type": "object"
    },
    "basis": {
      "type": "string"
    },
    "input_widening": {
      "type": "object",
      "required": [
        "converted",
        "exact"
      ],
      "description": "inputs converted exactly to binary64 before any product (precision.binary64); the statements concern the values as stored; the record's hashes are of the converted data, source_sha256 of each input as given",
      "properties": {
        "converted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "input",
              "dtype",
              "converted_to"
            ],
            "properties": {
              "input": {
                "type": "string"
              },
              "dtype": {
                "type": "string",
                "description": "the caller's dtype"
              },
              "converted_to": {
                "enum": [
                  "float64",
                  "complex128"
                ]
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "precision.source_sha256 of the input as given: array_sha256 of an array; format, shape and array_sha256 of each stored array of a sparse matrix"
              }
            }
          }
        },
        "exact": {
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex digest"
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "summary",
          "evidence",
          "hypotheses"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]+\\."
          },
          "status": {
            "enum": [
              "CERTIFIED",
              "CERTIFIED_UNDER_HYPOTHESIS",
              "DECLARED",
              "INCONCLUSIVE",
              "NOT_CHECKED",
              "FAILED"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "reason_code": {
                "enum": [
                  "BUDGET_MEMORY",
                  "BUDGET_TIME",
                  "DECLARED_ESTIMATE",
                  "DEFAULT_SELECTION",
                  "DEPENDENCY_NARROWED",
                  "FP_GUARD_RANGE",
                  "ILL_CONDITIONED_EIGENVECTORS",
                  "MISSING_DEPENDENCY",
                  "NARROWED_BY_USER",
                  "NEEDS_DEPENDENCY",
                  "NEEDS_EIGENVECTORS",
                  "NEEDS_MATRIX",
                  "NEEDS_OBSERVABLES",
                  "NEEDS_SPEC",
                  "NEEDS_TEMPERATURES",
                  "NEEDS_WHOLE_SPECTRUM",
                  "NONFINITE_BOUND",
                  "NOT_APPLICABLE",
                  "NOT_IMPLEMENTED",
                  "NO_CLUSTERS",
                  "NO_COMPLETENESS_CLAIM",
                  "OUT_OF_SCOPE_DYNAMICS",
                  "OUT_OF_SCOPE_EXTRAPOLATION",
                  "SIZE_LIMIT",
                  "UNDERFLOW_RISK",
                  "UNRESOLVED_VECTOR_NORM",
                  "UNSUPPORTED_CLAIM",
                  "UNSUPPORTED_MODEL"
                ]
              },
              "next_action": {
                "type": "string"
              }
            }
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "statement",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "statement": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "value": {}
              }
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "CERTIFIED_UNDER_HYPOTHESIS"
            }
          }
        },
        "then": {
          "properties": {
            "hypotheses": {
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
