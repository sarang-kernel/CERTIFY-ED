import CertifyApps.Engine
/-!
# Spin-1/2 Heisenberg models, symmetry sectors and their integer sector matrices

A model is a list of bonds `(i, j, c)` with integer `c`; the Hamiltonian is
`H = sum_b (c_b / D) S_i . S_j`, and the integer matrix `Hint = 4 D H` has, in the basis of `S^z` states,
diagonal entries `sum_b c_b (+1 if the two spins are parallel, -1 otherwise)` and the entry `2 c_b` between
two states that differ by exchanging the spins of an antiparallel bond `b`. A basis state is a natural
number whose bit `N - 1 - i` is the spin of site `i`, the convention of `certify_ed.basis`.

A symmetry is a site permutation, optionally followed by the global spin flip. The group generated by the
given generators is enumerated, every orbit of basis states gets the representative of smallest index, and
for a one-dimensional character `chi` with values in `{1, i, -1, -i}` the orbit sum of a representative `r`
is `w_r = sum_{t in O(r)} conj(chi(g_t)) e_t`, where `g_t` is any group element with `g_t r = t`; it is
nonzero exactly when `chi` is trivial on the stabiliser of `r`. These vectors are orthogonal, `|w_r|^2` is
the orbit size `|O(r)|`, and `Hint` maps their span into itself because every generator commutes with
`Hint` (checked exactly). The sector matrix is `A_{r'r} = w_{r'}^* Hint w_r = |O(r')| sum_{t in O(r)}
conj(chi(g_t)) Hint_{r' t}`, a Gaussian-integer Hermitian matrix (checked exactly).
-/
namespace CertifyApps

structure Heis where
  N : Nat
  bonds : Array (Nat × Nat × Int)
  /-- couplings are `c / D` -/
  D : Nat
  deriving Inhabited

/-- `Hint e_s` as a list of (state, amplitude). -/
def Heis.apply (m : Heis) (s : Nat) : Array (Nat × Int) := Id.run do
  let mut diag : Int := 0
  let mut out : Array (Nat × Int) := #[]
  for (i, j, c) in m.bonds do
    let bi := (s >>> (m.N - 1 - i)) % 2
    let bj := (s >>> (m.N - 1 - j)) % 2
    if bi == bj then diag := diag + c
    else
      diag := diag - c
      let t := s ^^^ ((1 <<< (m.N - 1 - i)) ||| (1 <<< (m.N - 1 - j)))
      out := out.push (t, 2 * c)
  if diag != 0 then out := out.push (s, diag)
  return out

/-- All `N`-bit states with `k` set bits, increasing. -/
def statesFixedWeight (N k : Nat) : Array Nat := Id.run do
  if k == 0 then return #[0]
  if k > N then return #[]
  let mut out : Array Nat := #[]
  let mut x : Nat := 2 ^ k - 1
  let lim : Nat := 2 ^ N
  while x < lim do
    out := out.push x
    -- Gosper's hack: next number with the same number of set bits
    let low := x &&& ((x ^^^ (x - 1)) &&& x)    -- lowest set bit
    let rr := x + low
    let ones := ((rr ^^^ x) / low) >>> 2
    x := rr ||| ones
  return out

/-- Index of a state in a sorted array, or `none`. -/
def findIdx (a : Array Nat) (s : Nat) : Option Nat := Id.run do
  let mut lo := 0
  let mut hi := a.size
  while lo < hi do
    let mid := (lo + hi) / 2
    let v := a[mid]!
    if v == s then return some mid
    if v < s then lo := mid + 1 else hi := mid
  return none

/-- A symmetry: site `i` goes to site `perm[i]`, then all spins flip if `flip`. -/
structure Sym where
  name : String
  perm : Array Nat
  flip : Bool
  order : Nat
  deriving Inhabited

def Sym.applyState (g : Sym) (N s : Nat) : Nat := Id.run do
  let mut t : Nat := 0
  for i in [0:N] do
    if (s >>> (N - 1 - i)) % 2 == 1 then
      t := t ||| (1 <<< (N - 1 - g.perm[i]!))
  if g.flip then t := t ^^^ (2 ^ N - 1)
  return t

/-- Group element: composite permutation and flip, with its exponents of the Gaussian-unit character
values recorded per generator along one word reaching it. -/
structure Elem where
  perm : Array Nat
  flip : Bool
  word : Array Nat    -- multiplicity of each generator along the BFS path
  deriving Inhabited, BEq

structure Group where
  gens : Array Sym
  elems : Array Elem
  /-- (from, generator, to) for every element and generator -/
  edges : Array (Nat × Nat × Nat)
  deriving Inhabited

/-- Close the generators into a group (as site maps with a flip bit). -/
def Group.generate (N : Nat) (gens : Array Sym) : Group := Id.run do
  let idp := Array.range N
  let mut elems : Array Elem := #[⟨idp, false, Array.replicate gens.size 0⟩]
  let mut edges : Array (Nat × Nat × Nat) := #[]
  let mut frontier : Array Nat := #[0]
  while frontier.size > 0 do
    let mut nxt : Array Nat := #[]
    for a in frontier do
      let ea := elems[a]!
      for gi in [0:gens.size] do
        let g := gens[gi]!
        -- apply ea, then g
        let p := (Array.range N).map (fun i => g.perm[ea.perm[i]!]!)
        let fl := ea.flip != g.flip
        let mut found := elems.size
        for k in [0:elems.size] do
          if found == elems.size && elems[k]!.perm == p && elems[k]!.flip == fl then found := k
        if found == elems.size then
          elems := elems.push ⟨p, fl, ea.word.modify gi (· + 1)⟩
          nxt := nxt.push found
        edges := edges.push (a, gi, found)
    frontier := nxt
  return ⟨gens, elems, edges⟩

/-- Character exponents (`chi = i^k`) of every element from generator exponents, or `none` if they do not
define a homomorphism (checked on every edge). -/
def Group.character (G : Group) (genExp : Array Nat) : Option (Array Nat) := Id.run do
  let n := G.elems.size
  let mut v : Array (Option Nat) := Array.replicate n none
  v := v.set! 0 (some 0)
  let mut changed := true
  while changed do
    changed := false
    for (a, gi, b) in G.edges do
      match v[a]!, v[b]! with
      | some x, none =>
          v := v.set! b (some ((x + genExp[gi]!) % 4))
          changed := true
      | _, _ => pure ()
  let mut out : Array Nat := #[]
  for x in v do
    match x with
    | some y => out := out.push y
    | none => return none
  for (a, gi, b) in G.edges do
    if (out[a]! + genExp[gi]!) % 4 != out[b]! then return none
  return some out

def Elem.applyState (g : Elem) (N s : Nat) : Nat := Id.run do
  let mut t : Nat := 0
  for i in [0:N] do
    if (s >>> (N - 1 - i)) % 2 == 1 then
      t := t ||| (1 <<< (N - 1 - g.perm[i]!))
  if g.flip then t := t ^^^ (2 ^ N - 1)
  return t

/-- Orbits of the group on a closed, sorted state set. -/
structure Orbits where
  repOf : Array Nat           -- state index -> representative state index
  elemOf : Array Nat          -- state index -> element g with g rep = state
  reps : Array Nat            -- representatives (state indices), increasing
  size : Array Nat            -- orbit size per representative (same order as reps)
  stab : Array (Array Nat)    -- stabiliser elements per representative
  ok : Bool
  deriving Inhabited

def orbits (N : Nat) (states : Array Nat) (G : Group) : Orbits := Id.run do
  let n := states.size
  let none' := n
  let mut repOf : Array Nat := Array.replicate n none'
  let mut elemOf : Array Nat := Array.replicate n 0
  let mut reps : Array Nat := #[]
  let mut sizes : Array Nat := #[]
  let mut stabs : Array (Array Nat) := #[]
  for s in [0:n] do
    if repOf[s]! == none' then
      let mut st : Array Nat := #[]
      let mut cnt := 0
      for gi in [0:G.elems.size] do
        let t := G.elems[gi]!.applyState N states[s]!
        match findIdx states t with
        | none => return ⟨repOf, elemOf, reps, sizes, stabs, false⟩
        | some ti =>
            if ti == s then st := st.push gi
            if repOf[ti]! == none' then
              repOf := repOf.set! ti s
              elemOf := elemOf.set! ti gi
              cnt := cnt + 1
      reps := reps.push s
      sizes := sizes.push cnt
      stabs := stabs.push st
  return ⟨repOf, elemOf, reps, sizes, stabs, true⟩

/-- Exact check that every generator commutes with `Hint` on the state set:
`Hint[g t, g s] = Hint[t, s]` for every stored entry (both are sets of the same size). -/
def commutes (m : Heis) (states : Array Nat) (g : Sym) : Bool := Id.run do
  for s in states do
    let gs := g.applyState m.N s
    let a := (m.apply s).map (fun (t, h) => (g.applyState m.N t, h))
    let b := m.apply gs
    if a.size != b.size then return false
    let lt : Nat × Int → Nat × Int → Bool := fun x y => x.1 < y.1 || (x.1 == y.1 && x.2 < y.2)
    if a.qsort lt != b.qsort lt then return false
  return true

/-- A symmetry sector: Gaussian-integer Hermitian sector matrix in sparse rows and the orbit sizes. -/
structure Sector where
  label : Array Nat           -- character exponents of the generators (chi(gen) = i^k)
  reps : Array Nat            -- representative state indices
  re : Array (Array (Nat × Int))
  im : Array (Array (Nat × Int))
  nrm : Array Nat             -- |w_r|^2 = orbit sizes
  deriving Inhabited

def Sector.dim (s : Sector) : Nat := s.reps.size
def Sector.isReal (s : Sector) : Bool := s.im.all (·.all (fun (_, v) => v == 0))

/-- conj(i^k) as (re, im). -/
@[inline] def conjUnit (k : Nat) : Int × Int :=
  match k % 4 with
  | 0 => (1, 0) | 1 => (0, -1) | 2 => (-1, 0) | _ => (0, 1)

/-- The sector of a character (exponents per element). -/
def buildSector (m : Heis) (states : Array Nat) (ob : Orbits) (chi : Array Nat) (label : Array Nat) :
    Sector := Id.run do
  let n := states.size
  -- reps in the sector and their positions
  let mut pos : Array Nat := Array.replicate n n
  let mut reps : Array Nat := #[]
  let mut nrm : Array Nat := #[]
  for k in [0:ob.reps.size] do
    if ob.stab[k]!.all (fun g => chi[g]! % 4 == 0) then
      pos := pos.set! ob.reps[k]! reps.size
      reps := reps.push ob.reps[k]!
      nrm := nrm.push ob.size[k]!
  let dimS := reps.size
  let mut reRows : Array (Array (Nat × Int)) := #[]
  let mut imRows : Array (Array (Nat × Int)) := #[]
  let mut accRe : Array Int := Array.replicate dimS 0
  let mut accIm : Array Int := Array.replicate dimS 0
  for a in [0:dimS] do
    let r' := reps[a]!
    let mut touched : Array Nat := #[]
    for (t, h) in m.apply states[r']! do
      match findIdx states t with
      | none => pure ()
      | some ti =>
        let r := ob.repOf[ti]!
        let b := pos[r]!
        if b < dimS then
          let (cr, ci) := conjUnit chi[ob.elemOf[ti]!]!
          let f : Int := ((nrm[a]! : Nat) : Int) * h
          if accRe[b]! == 0 && accIm[b]! == 0 then touched := touched.push b
          accRe := accRe.modify b (· + f * cr)
          accIm := accIm.modify b (· + f * ci)
    let sortedT := touched.qsort (· < ·)
    let mut rr : Array (Nat × Int) := #[]
    let mut ri : Array (Nat × Int) := #[]
    for b in sortedT do
      if accRe[b]! != 0 then rr := rr.push (b, accRe[b]!)
      if accIm[b]! != 0 then ri := ri.push (b, accIm[b]!)
      accRe := accRe.set! b 0
      accIm := accIm.set! b 0
    reRows := reRows.push rr
    imRows := imRows.push ri
  return ⟨label, reps, reRows, imRows, nrm⟩

/-- Exact antisymmetry of sparse rows: every `(i, j, v)` has a matching `(j, i, -v)`. -/
def spAntisymmetric (n : Nat) (rows : Array (Array (Nat × Int))) : Bool := Id.run do
  let mut a : Array (Nat × Nat × Int) := #[]
  let mut b : Array (Nat × Nat × Int) := #[]
  for i in [0:n] do
    for (j, v) in rows[i]! do
      if v != 0 then
        a := a.push (i, j, v)
        b := b.push (j, i, -v)
  let lt : Nat × Nat × Int → Nat × Nat × Int → Bool := fun x y =>
    x.1 < y.1 || (x.1 == y.1 && (x.2.1 < y.2.1 || (x.2.1 == y.2.1 && x.2.2 < y.2.2)))
  let sa := a.qsort lt
  let sb := b.qsort lt
  return sa.size == sb.size && (Array.range sa.size).all (fun k => sa[k]! == sb[k]!)

/-- Exact Hermiticity of a sector matrix: `re` symmetric and `im` antisymmetric. -/
def Sector.hermitian (s : Sector) : Bool := spSymmetric s.dim s.re && spAntisymmetric s.dim s.im

/-- Sparse symmetric matrix of the counting problem at `g = a / b`: the real form of
`b A - a den N` (dimension `dim` or `2 dim` for a complex sector) with its weights. -/
def Sector.shifted (s : Sector) (den : Nat) (g : Rat) : IMat × Array Nat × Bool := Id.run do
  let a := g.num
  let b : Int := g.den
  let n := s.dim
  let real := s.isReal
  let diagShift := fun (i : Nat) => a * (den : Int) * ((s.nrm[i]! : Nat) : Int)
  let mkRow := fun (i : Nat) (rows : Array (Array (Nat × Int))) (off : Nat) (sgn : Int) =>
    rows[i]!.map (fun (j, v) => (j + off, sgn * b * v))
  if real then
    let rows := (Array.range n).map (fun i =>
      ((mkRow i s.re 0 1).push (i, -(diagShift i))))
    return (.sp n rows, s.nrm, true)
  else
    -- [[bRe - a den N, -b Im], [b Im, bRe - a den N]]
    let top := (Array.range n).map (fun i =>
      ((mkRow i s.re 0 1).push (i, -(diagShift i))) ++ mkRow i s.im n (-1))
    let bot := (Array.range n).map (fun i =>
      (mkRow i s.im 0 1 ++ (mkRow i s.re n 1)).push (i + n, -(diagShift i)))
    return (.sp (2 * n) (top ++ bot), s.nrm ++ s.nrm, false)

end CertifyApps
