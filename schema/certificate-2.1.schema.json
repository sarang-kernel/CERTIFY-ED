    "gaps_record": {
      "type": "object",
      "required": [
        "refers_to",
        "ranked",
        "levels",
        "gaps"
      ],
      "description": "levels: maximal chains of overlapping S2 enclosures (radii including the model shift), each holding exactly `count` eigenvalues when S3 is CERTIFIED; gaps: intervals for the differences of consecutive eigenvalues, ends rounded outward, upper end 'inf' when the next eigenvalue is not claimed (then the lower end is S3's gap_lower_bound)",
      "properties": {
        "refers_to": {
          "type": "string"
        },
        "ranked": {
          "type": "boolean"
        },
        "rank_origin": {
          "type": "string"
        },
        "n_levels": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lower",
              "upper",
              "members",
              "count"
            ],
            "properties": {
              "lower": {
                "$ref": "#/$defs/number_or_special"
              },
              "upper": {
                "$ref": "#/$defs/number_or_special"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "ranks": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap_record"
          }
        },
        "top_gap": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/gap_record"
            }
          ]
        }
      }
    },
